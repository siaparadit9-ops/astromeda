/* ---- pabrik tekstur prosedural (equirectangular 192×96) ---- */
function texCanvas(){ var c = document.createElement('canvas'); c.width = 192; c.height = 96; return c; }
function speckle(x, n, colors, rng, s0, s1, alpha){
  for(var i=0;i<n;i++){
    x.fillStyle = colors[(rng()*colors.length)|0];
    x.globalAlpha = alpha*(.4+rng()*.6);
    var s = s0+rng()*(s1-s0);
    x.fillRect(rng()*192, rng()*96, s, s*.7);
  }
  x.globalAlpha = 1;
}
function makeTexMercury(){
  var c = texCanvas(), x = c.getContext('2d'), rng = mulberry32(11);
  x.fillStyle = '#8F8574'; x.fillRect(0,0,192,96);
  speckle(x, 700, ['#7A7163','#A2988A','#6B6357','#B0A695'], rng, .6, 2.4, .5);
  for(var i=0;i<90;i++){
    var px = rng()*192, py = rng()*96, r = .8+rng()*4;
    x.fillStyle = 'rgba(90,82,70,.55)';
    x.beginPath(); x.arc(px,py,r,0,TAU); x.fill();
    x.strokeStyle = 'rgba(200,190,170,.4)'; x.lineWidth = .6;
    x.beginPath(); x.arc(px-r*.2,py-r*.2,r*.8,Math.PI,Math.PI*1.7); x.stroke();
  }
  return c;
}
function makeTexVenus(){
  var c = texCanvas(), x = c.getContext('2d'), rng = mulberry32(22);
  var g = x.createLinearGradient(0,0,0,96);
  g.addColorStop(0,'#E8D5A8'); g.addColorStop(.5,'#D9B87C'); g.addColorStop(1,'#C9A768');
  x.fillStyle = g; x.fillRect(0,0,192,96);
  for(var i=0;i<16;i++){
    x.strokeStyle = 'rgba(255,244,214,'+(.05+rng()*.09)+')';
    x.lineWidth = 2+rng()*5;
    x.beginPath();
    var y0 = rng()*96;
    x.moveTo(-5, y0);
    x.bezierCurveTo(60, y0-8-rng()*10, 130, y0+6+rng()*12, 197, y0+(rng()-.5)*10);
    x.stroke();
  }
  return c;
}
function makeTexEarth(){
  var c = texCanvas(), x = c.getContext('2d'), rng = mulberry32(33);
  var g = x.createLinearGradient(0,0,0,96);
  g.addColorStop(0,'#2E6E8E'); g.addColorStop(.5,'#255B79'); g.addColorStop(1,'#2E6E8E');
  x.fillStyle = g; x.fillRect(0,0,192,96);
  var landCols = ['#5E7A4A','#7A8A56','#96865C','#6B7C4E'];
  for(var i=0;i<11;i++){
    var cx = rng()*192, cy = 18+rng()*60, parts = 4+((rng()*5)|0);
    for(var j=0;j<parts;j++){
      x.fillStyle = landCols[(rng()*landCols.length)|0];
      x.beginPath();
      x.arc(cx+gGauss(rng)*13, cy+gGauss(rng)*7, 3+rng()*7, 0, TAU);
      x.fill();
    }
  }
  x.fillStyle = '#F2F0E4';
  x.fillRect(0,0,192,6); x.fillRect(0,90,192,6);
