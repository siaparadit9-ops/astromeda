var SYN = 29.530588853;
var EPOCH = Date.UTC(2000,0,6,18,14)/86400000;
var CRATERS = [[-28,-18,13],[24,12,9],[-4,36,7],[38,-30,5],[-44,22,6]];
var MP_VALS = [0,.125,.25,.375,.5,.625,.75,.875];
var mS = {cv:null, ctx:null, p:.5, live:true, size:300, dpr:1};
function moonAgeNow(){
  var d = Date.now()/86400000 - EPOCH;
  return ((d % SYN) + SYN) % SYN;
}
function phaseName(p){
  var a = p*SYN;
  if(a < 1.85 || a >= 27.68) return 'Bulan Baru';
  if(a < 5.53)  return 'Sabit Muda';
  if(a < 9.22)  return 'Kuartal Pertama';
  if(a < 12.91) return 'Gilip Muda';
  if(a < 16.61) return 'Purnama';
  if(a < 20.30) return 'Gilip Tua';
  if(a < 23.99) return 'Kuartal Ketiga';
  return 'Sabit Tua';
}
function drawPhase(c, cx0, cy0, r, p){
  var lit = '#EFE5CE', dark = '#0E1A36';
  c.clearRect(cx0-r-8, cy0-r-8, (r+8)*2, (r+8)*2);
  c.fillStyle = dark;
  c.beginPath(); c.arc(cx0,cy0,r,0,TAU); c.fill();
  var waxing = p < .5;
  c.fillStyle = lit; c.beginPath();
  if(waxing) c.arc(cx0,cy0,r,-Math.PI/2,Math.PI/2,false);
  else       c.arc(cx0,cy0,r,Math.PI/2,Math.PI*1.5,false);
  c.closePath(); c.fill();
  var sx = r*Math.abs(Math.cos(TAU*p));
  var fillDark = (waxing && p < .25) || (!waxing && p >= .75);
  c.fillStyle = fillDark ? dark : lit;
  c.beginPath(); c.ellipse(cx0,cy0,sx,r,0,0,TAU); c.fill();
  c.globalAlpha = .1; c.fillStyle = '#0A1226';
  CRATERS.forEach(function(cr){
    c.beginPath();
    c.arc(cx0+cr[0]*r/100, cy0+cr[1]*r/100, cr[2]*r/100, 0, TAU);
    c.fill();
  });
  c.globalAlpha = 1;
  c.strokeStyle = 'rgba(201,164,76,.5)'; c.lineWidth = 1.2;
  c.beginPath(); c.arc(cx0,cy0,r+5,0,TAU); c.stroke();
}
function drawMoonUI(){
  if(mS.live) mS.p = (moonAgeNow()/SYN) % 1;
  var age = mS.p*SYN;
  if(mS.ctx){
    mS.ctx.setTransform(mS.dpr,0,0,mS.dpr,0,0);
    mS.ctx.clearRect(0,0,mS.size,mS.size);
    drawPhase(mS.ctx, mS.size/2, mS.size/2, mS.size*.4, mS.p);
  }
  var nm = $('#moonName'); if(nm) nm.textContent = phaseName(mS.p);
  var ag = $('#moonAge'); if(ag) ag.textContent = fmt(age,1) + ' hari';
  var il = $('#moonIllum'); if(il) il.textContent = fmt((1-Math.cos(TAU*mS.p))/2*100,0) + '%';
  var nx = $('#moonNext');
  if(nx) nx.textContent = 'dalam ' + fmt((((SYN/2 - mS.p*SYN)%SYN)+SYN)%SYN,1) + ' hari';
  var r = $('#moonRange');
  if(r && Math.abs(+r.value - mS.p*1000) > 2) r.value = Math.round(mS.p*1000);
