    g4.addColorStop(1,'rgba(255,217,166,0)');
    gx2.fillStyle = g4;
    gx2.beginPath(); gx2.arc(px,py,14,0,TAU); gx2.fill();
    for(var m=0;m<34;m++){
      gx2.fillStyle = 'rgba(239,229,206,'+(.25+rng()*.5)+')';
      gx2.fillRect(px+gGauss(rng)*8, py+gGauss(rng)*8, 1, 1);
    }
  }
  gMod.layers = L;
}

