var cv = $('#starfield'), ctx = cv.getContext('2d');
var W = 0, H = 0, DPR = 1;
var stars = [], shots = [], ripples = [], trailPts = [], confetti = [];
var DENSITY = {low:9000, normal:4800, high:2900};
var densityKey = 'normal';
var mouseNX = 0, mouseNY = 0, parX = 0, parY = 0;
var rawX = .5, rawY = .5;
var lastFrame = 0, frameAcc = 0, frameN = 0, fpsAvg = 16.7;
var adapted = false;
var warp = 0, warpTgt = 0, warpTO = null;
var tickers = [];
function addTicker(fn){ tickers.push(fn); }

var STAR_COLORS = ['#FAF7EF','#FAF7EF','#EFE5CE','#EFE5CE','#E4C97E','#E4C97E','#6FB48D'];

function sizeCanvas(){
  DPR = Math.min(window.devicePixelRatio||1, 2);
  W = window.innerWidth; H = window.innerHeight;
  cv.width  = Math.round(W*DPR);
  cv.height = Math.round(H*DPR);
  cv.style.width = W+'px'; cv.style.height = H+'px';
  ctx.setTransform(DPR,0,0,DPR,0,0);
}
function buildStars(){
  stars = [];
  var n = Math.max(120, Math.round((W*H)/DENSITY[densityKey]));
  for(var i=0;i<n;i++){
    var r = Math.random();
    stars.push({
      x: Math.random()*W, y: Math.random()*H,
      z: r<.5 ? .3 : (r<.85 ? .6 : 1),
      s: .4 + Math.random()*1.3,
      tw: .5 + Math.random()*1.8,
      ph: Math.random()*TAU,
      base: .35 + Math.random()*.6,
      c: STAR_COLORS[(Math.random()*STAR_COLORS.length)|0]
    });
  }
}
var rsT = null;
window.addEventListener('resize', function(){
  clearTimeout(rsT);
  rsT = setTimeout(function(){
    sizeCanvas(); buildStars();
    gResize(); if(REDUCED) gDraw(performance.now());
    oResize(); if(REDUCED) oDraw(performance.now());
    if(REDUCED) drawFrame(0, 0);
  }, 180);
});

function spawnShot(){
  if(shots.length >= 2 || REDUCED) return;
  var fromLeft = Math.random() < .5;
  shots.push({
    x: fromLeft ? -40 : W*(.3+Math.random()*.7),
    y: Math.random()*H*.4,
    vx: (fromLeft?1:-1)*(700+Math.random()*600),
    vy: 320+Math.random()*260,
    life: 0, max: .9+Math.random()*.5,
    tail: 120+Math.random()*110
  });
}
var shotTimer = 2.2, shotNext = 2.2;

function spawnRipple(x,y){
  if(REDUCED) return;
  ripples.push({x:x, y:y, r:4, life:1});
  ripples.push({x:x, y:y, r:-10, life:1});
}
function spawnConfetti(n){
  if(REDUCED) return;
  var cols = ['#E4C97E','#C9A44C','#EFE5CE','#6FB48D','#FAF7EF'];
  for(var i=0;i<n;i++){
    var a = Math.random()*TAU, sp = 130+Math.random()*430;
    confetti.push({
      x: W/2, y: H/2,
      vx: Math.cos(a)*sp, vy: Math.sin(a)*sp - 120,
      life: 1, decay: .28+Math.random()*.3,
      s: 2+Math.random()*4,
      c: cols[(Math.random()*cols.length)|0],
      spin: Math.random()*Math.PI
    });
  }
}
function triggerWarp(ms){
  if(REDUCED) return;
  warpTgt = 1;
  clearTimeout(warpTO);
  warpTO = setTimeout(function(){ warpTgt = 0; }, ms||2400);
}

function drawFrame(dt, t){
  ctx.clearRect(0,0,W,H);
  var i, st;
  var cx = W/2, cy = H/2;
  for(i=0;i<stars.length;i++){
    st = stars[i];
    var a = st.base*(.62+.38*Math.sin(t*.001*st.tw+st.ph));
    if(warp > .02){
      var dx = st.x-cx, dy = st.y-cy;
      var dist = Math.sqrt(dx*dx+dy*dy)||1;
      var nx = dx/dist, ny = dy/dist;
      var sp = (280+warp*2100)*st.z;
      st.x += nx*sp*dt; st.y += ny*sp*dt;
      var len = warp*(20+70*st.z);
      ctx.globalAlpha = a;
      ctx.strokeStyle = st.c; ctx.lineWidth = 1.1;
      ctx.beginPath();
      ctx.moveTo(st.x-nx*len, st.y-ny*len);
      ctx.lineTo(st.x, st.y);
      ctx.stroke();
      if(st.x<-60||st.x>W+60||st.y<-60||st.y>H+60){
        st.x = cx+(Math.random()-.5)*W*.5;
        st.y = cy+(Math.random()-.5)*H*.5;
      }
    }else{
      if(dt>0){ st.x -= (3+8*st.z)*dt; st.y += (1+2.2*st.z)*dt; }
      if(st.x < -4) st.x = W+4;
      if(st.y > H+4) st.y = -4;
      ctx.globalAlpha = a;
      ctx.fillStyle = st.c;
      var px = st.x + parX*st.z, py = st.y + parY*st.z;
      if(st.s < 1.1){ ctx.fillRect(px,py,st.s+.3,st.s+.3); }
      else{ ctx.beginPath(); ctx.arc(px,py,st.s*.7,0,TAU); ctx.fill(); }
    }
  }
  for(i=shots.length-1;i>=0;i--){
    var sh = shots[i];
    sh.life += dt;
    sh.x += sh.vx*dt; sh.y += sh.vy*dt;
    var p = sh.life/sh.max;
    if(p>=1 || sh.x<-250 || sh.x>W+250 || sh.y>H+250){ shots.splice(i,1); continue; }
    var mag = Math.sqrt(sh.vx*sh.vx+sh.vy*sh.vy);
    var tx = sh.x - sh.vx/mag*sh.tail, ty = sh.y - sh.vy/mag*sh.tail;
    var fade = Math.sin(p*Math.PI);
    var g = ctx.createLinearGradient(sh.x,sh.y,tx,ty);
    g.addColorStop(0,'rgba(228,201,126,'+(.9*fade)+')');
    g.addColorStop(1,'rgba(228,201,126,0)');
    ctx.globalAlpha = 1; ctx.strokeStyle = g; ctx.lineWidth = 1.6;
    ctx.beginPath(); ctx.moveTo(sh.x,sh.y); ctx.lineTo(tx,ty); ctx.stroke();
    ctx.globalAlpha = fade; ctx.fillStyle = '#FAF7EF';
    ctx.beginPath(); ctx.arc(sh.x,sh.y,1.6,0,TAU); ctx.fill();
  }
  for(i=ripples.length-1;i>=0;i--){
    var rp = ripples[i];
    rp.r += 300*dt; rp.life -= dt*1.7;
    if(rp.life <= 0){ ripples.splice(i,1); continue; }
    ctx.globalAlpha = rp.life*.5;
    ctx.strokeStyle = '#C9A44C'; ctx.lineWidth = 1.4;
    ctx.beginPath(); ctx.arc(rp.x,rp.y,Math.max(0,rp.r),0,TAU); ctx.stroke();
  }
  if(trailPts.length > 1){
    ctx.lineWidth = 1;
    for(i=1;i<trailPts.length;i++){
      var p0 = trailPts[i-1], p1 = trailPts[i];
      var age = t - p1.t;
      var al = Math.max(0, 1-age/1400)*.4;
      if(al <= 0) continue;
      ctx.globalAlpha = al; ctx.strokeStyle = '#E4C97E';
      ctx.beginPath(); ctx.moveTo(p0.x,p0.y); ctx.lineTo(p1.x,p1.y); ctx.stroke();
    }
    var lastP = trailPts[trailPts.length-1];
    ctx.globalAlpha = .7; ctx.fillStyle = '#E4C97E';
    ctx.beginPath(); ctx.arc(lastP.x,lastP.y,1.4,0,TAU); ctx.fill();
  }
  for(i=confetti.length-1;i>=0;i--){
    var cf = confetti[i];
    cf.x += cf.vx*dt; cf.y += cf.vy*dt;
    cf.vy += 260*dt; cf.life -= cf.decay*dt; cf.spin += dt*4;
    if(cf.life <= 0){ confetti.splice(i,1); continue; }
    ctx.globalAlpha = Math.min(1,cf.life);
    ctx.strokeStyle = cf.c; ctx.lineWidth = 1.3;
    ctx.save(); ctx.translate(cf.x,cf.y); ctx.rotate(cf.spin);
    ctx.beginPath();
    ctx.moveTo(-cf.s,0); ctx.lineTo(cf.s,0);
    ctx.moveTo(0,-cf.s); ctx.lineTo(0,cf.s);
    ctx.stroke(); ctx.restore();
  }
  ctx.globalAlpha = 1;
}

/* loop master */
var rafId = null, coordTick = 0;
function loop(t){
  var dt = lastFrame ? Math.min(.05,(t-lastFrame)/1000) : .016;
  lastFrame = t;
  warp += (warpTgt-warp)*.06;
  parX += (mouseNX*22 - parX)*.05;
  parY += (mouseNY*14 - parY)*.05;
  shotTimer += dt;
  if(shotTimer >= shotNext){ spawnShot(); shotTimer = 0; shotNext = 4+Math.random()*6; }
  while(trailPts.length && t-trailPts[0].t > 1500) trailPts.shift();
  drawFrame(dt, t);
  cursorFrame(t);
  for(var i=0;i<tickers.length;i++){ try{ tickers[i](dt,t); }catch(e){} }
  frameAcc += dt*1000; frameN++;
  if(frameN >= 30){
    fpsAvg = frameAcc/frameN; frameAcc = 0; frameN = 0;
    updateFPS();
    if(!adapted && fpsAvg > 18.5 && stars.length > 260){
      stars.splice(0, Math.floor(stars.length*.18));
      adapted = true; $('#qualityTag').hidden = false;
    }
  }
  if(++coordTick >= 6){ coordTick = 0; updateCoords(); }
  rafId = requestAnimationFrame(loop);
}
function startEngine(){
  sizeCanvas(); buildStars();
  if(REDUCED){
    parX = 0; parY = 0;
    drawFrame(0, 0);
    $('#fpsVal').textContent = 'MODE HEMAT';
    return;
  }
  lastFrame = 0;
  rafId = requestAnimationFrame(loop);
}
document.addEventListener('visibilitychange', function(){
  if(REDUCED) return;
  if(document.hidden){ if(rafId) cancelAnimationFrame(rafId); rafId = null; }
  else if(!rafId){ lastFrame = 0; rafId = requestAnimationFrame(loop); }
});
function setDensity(k){
