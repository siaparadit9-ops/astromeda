function fuzzy(q, s){
  if(!q) return {idx:[]};
  q = q.toLowerCase(); var t = s.toLowerCase(), qi = 0, idx = [];
  for(var i=0;i<t.length && qi<q.length;i++){
    if(t[i] === q[qi]){ idx.push(i); qi++; }
  }
  return qi === q.length ? {idx:idx} : null;
}
function hlLabel(s, idx){
  if(!idx || !idx.length) return s;
  var out = '', j = 0;
  for(var i=0;i<s.length;i++){
