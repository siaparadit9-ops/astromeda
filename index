        $('#oTipName').textContent = O_P[h].n;
        $('#oTipSub').textContent = O_P[h].cls.toLowerCase() + ' · klik untuk data';
        tip.style.left = mx+'px'; tip.style.top = my+'px';
        tip.classList.add('show');
      } else tip.classList.remove('show');
    }
  });
  cvo.addEventListener('pointerup', function(e){
    if(!oS.drag) return;
    var wasClick = oS.drag.moved < 7;
    oS.drag = null;
    if(!wasClick) return;
    var r = cvo.getBoundingClientRect();
    var mx = e.clientX-r.left, my = e.clientY-r.top;
    for(var i=0;i<oS.scr.length;i++){
      if(Math.hypot(oS.scr[i].x-mx, oS.scr[i].y-my) < Math.max(14, oS.scr[i].r+8)){
        selectO(i); return;
      }
    }
  });
  cvo.addEventListener('pointercancel', function(){ oS.drag = null; });
  cvo.addEventListener('pointerleave', function(){
    oS.hover = -1; window.__oHot = false;
    if(tip) tip.classList.remove('show');
  });
  cvo.addEventListener('wheel', function(e){
    e.preventDefault();
    var r = cvo.getBoundingClientRect();
    oZoomAt(e.clientX-r.left, e.clientY-r.top, Math.exp(-e.deltaY*.0014));
    if(REDUCED) oDraw(performance.now());
  }, {passive:false});
  buildChips();
  buildTable();
  selectO(oS.sel, true);
  syncFocusUI();
  if(REDUCED) oDraw(performance.now());
}

