var rev = new IntersectionObserver(function(es){
  es.forEach(function(en){
    if(!en.isIntersecting) return;
    var el = en.target;
    if(el.hasAttribute && el.hasAttribute('data-split')) splitText(el);
    if(el.hasAttribute && el.hasAttribute('data-words')) wordify(el);
    el.classList.add('in');
    el.dataset.visited = '1';
    scrambleIn(el);
    rev.unobserve(el);
  });
},{threshold:.12, rootMargin:'0px 0px -40px 0px'});

var sectorObs = new IntersectionObserver(function(es){
  es.forEach(function(en){
    if(en.isIntersecting && en.target.dataset.sector){
      altSector.textContent = 'SEKTOR ' + en.target.dataset.sector;
    }
  });
},{rootMargin:'-45% 0px -50% 0px', threshold:0});

var SCRAMBLE_CHARS = 'ΔΘΛΞΣΦΨΩ◇·01';
function scramble(el){
  if(!el.dataset.orig) el.dataset.orig = el.textContent;
  var orig = el.dataset.orig;
  el.dataset.done = '1';
  if(REDUCED){ el.textContent = orig; return; }
  var len = orig.length, start = performance.now(), dur = 420 + len*26;
  function frame(t){
    if(el.dataset.done !== '1'){ return; }
    var p = Math.min(1,(t-start)/dur), reveal = Math.floor(p*len), out = '';
    for(var i=0;i<len;i++){
      var ch = orig[i];
      out += (ch===' ') ? ' ' : (i<reveal ? ch : SCRAMBLE_CHARS[(Math.random()*SCRAMBLE_CHARS.length)|0]);
    }
    el.textContent = out;
    if(p<1) requestAnimationFrame(frame);
    else el.textContent = orig;
  }
  requestAnimationFrame(frame);
}
function scrambleIn(scope){
  var list = $$('[data-scramble]', scope);
  if(scope.matches && scope.matches('[data-scramble]')) list.unshift(scope);
  list.forEach(function(el,i){
    if(el.dataset.done) return;
    el.dataset.done = '0';
    setTimeout(function(){ scramble(el); }, i*130);
  });
}
var cntObs = new IntersectionObserver(function(es){
  es.forEach(function(en){
    if(!en.isIntersecting) return;
    cntObs.unobserve(en.target);
    var el = en.target, target = parseInt(el.dataset.count,10)||0;
    if(REDUCED){ el.textContent = target; return; }
    var start = null, dur = 1600;
    function step(t){
      if(!start) start = t;
      var p = Math.min(1,(t-start)/dur);
      el.textContent = Math.round(target*(1-Math.pow(1-p,3)));
      if(p<1) requestAnimationFrame(step);
    }
    requestAnimationFrame(step);
  });
},{threshold:.5});
function observeAll(){
  $$('[data-reveal],[data-split],[data-words]').forEach(function(el){
    if(!el.classList.contains('in')) rev.observe(el);
  });
  $$('[data-sector]').forEach(function(el){ sectorObs.observe(el); });
  $$('[data-count]').forEach(function(el){ cntObs.observe(el); });
}

