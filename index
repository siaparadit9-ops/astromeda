  x.globalAlpha = 1;
  x.fillStyle = '#01030A';
  x.beginPath(); x.arc(0,0,9.5,0,TAU); x.fill();
  x.strokeStyle = 'rgba(255,250,235,'+(.85*fl)+')'; x.lineWidth = 1.4;
  x.beginPath(); x.arc(0,0,11,0,TAU); x.stroke();
  x.restore();
}

function gDraw(t){
  var x = gMod.ctx; if(!x) return;
  var Wd = gMod.W, Hd = gMod.H;
  x.setTransform(gMod.DPR,0,0,gMod.DPR,0,0);
  x.clearRect(0,0,Wd,Hd);
  var cx = Wd/2 + gMod.panX, cy = Hd/2 + gMod.panY;
  var zf = gMod.scale/gMod.fit;
  x.save();
  x.translate(cx,cy); x.rotate(gMod.rot); x.scale(gMod.scale,gMod.scale);
  x.drawImage(gMod.layers.bg, -700, -450);
  x.drawImage(gMod.layers.neb, -700, -450);
  x.drawImage(gMod.layers.dust, -700, -450);
  x.drawImage(gMod.layers.hii, -700, -450);
  x.drawImage(gMod.layers.halo, -700, -450);
  /* bintang: kecil = kotak, besar = sprite glow, raksasa = paku difraksi */
  var i, st, gs;
  for(i=0;i<gMod.stars.length;i++){
    st = gMod.stars[i];
    var a = st.a*(.7+.3*Math.sin(t*.0012*st.tw+st.ph));
    if(st.s >= 1.7){
      gs = glowSprite(st.c);
      x.globalAlpha = a*.9;
      var sz = st.s*5;
      x.drawImage(gs, st.x-sz/2, st.y-sz/2, sz, sz);
      if(st.s >= 2.4){
        x.globalAlpha = a*.5;
        x.strokeStyle = st.c; x.lineWidth = .5;
        x.beginPath();
        x.moveTo(st.x-st.s*2.6, st.y); x.lineTo(st.x+st.s*2.6, st.y);
        x.moveTo(st.x, st.y-st.s*2.6); x.lineTo(st.x, st.y+st.s*2.6);
        x.stroke();
      }
    }else{
      x.globalAlpha = a;
      x.fillStyle = st.c;
      x.fillRect(st.x, st.y, st.s, st.s);
    }
  }
  /* lubang hitam di inti */
  if(zf > 5) gDrawBH(x, t, zf);
  /* rasi tersimpan + rasi sedang digambar */
  function drawPath(idxArr, alpha, previewTo){
    if(idxArr.length < 2 && !previewTo) return;
    x.globalAlpha = alpha;
    x.strokeStyle = '#E4C97E'; x.lineWidth = 1/gMod.scale*1.2;
    x.beginPath();
    for(var q=0;q<idxArr.length;q++){
      var s2 = gMod.stars[idxArr[q]];
      if(!s2) continue;
      if(q===0) x.moveTo(s2.x,s2.y); else x.lineTo(s2.x,s2.y);
    }
    if(previewTo) x.lineTo(previewTo.x, previewTo.y);
    x.stroke();
    x.fillStyle = '#E4C97E';
    for(q=0;q<idxArr.length;q++){
      var s3 = gMod.stars[idxArr[q]];
      if(!s3) continue;
      x.beginPath(); x.arc(s3.x,s3.y,1.6/gMod.scale*1.2,0,TAU); x.fill();
    }
  }
  for(i=0;i<gMod.paths.length;i++) drawPath(gMod.paths[i], .55, null);
  if(gMod.cmode && gMod.cpath.length){
    drawPath(gMod.cpath, .9, gMod.mouse ? gScreenToGal(gMod.mouse.x, gMod.mouse.y) : null);
    if(gMod.cHover >= 0 && gMod.stars[gMod.cHover]){
      var hs = gMod.stars[gMod.cHover];
      x.globalAlpha = .9; x.strokeStyle = '#FAF7EF';
      x.lineWidth = 1/gMod.scale;
      x.beginPath(); x.arc(hs.x,hs.y,7/gMod.scale,0,TAU); x.stroke();
    }
  }
  /* bintang besar yang bisa dinamai */
  gMod.mscr = [];
  for(i=0;i<gMod.majors.length;i++){
    var m = gMod.majors[i];
    x.globalAlpha = .16; x.fillStyle = '#E4C97E';
    x.beginPath(); x.arc(m.x, m.y, 14, 0, TAU); x.fill();
    x.globalAlpha = 1; x.fillStyle = '#FAF7EF';
    x.beginPath(); x.arc(m.x, m.y, 3.4, 0, TAU); x.fill();
    var rx = Math.cos(gMod.rot)*m.x - Math.sin(gMod.rot)*m.y;
    var ry = Math.sin(gMod.rot)*m.x + Math.cos(gMod.rot)*m.y;
    gMod.mscr.push({x: cx + rx*gMod.scale, y: cy + ry*gMod.scale});
  }
  x.restore(); x.globalAlpha = 1;
  /* label ruang-layar untuk bintang besar */
  x.font = '9.5px "JetBrains Mono",monospace'; x.textAlign = 'center';
  if(zf > 1.8){
    for(i=0;i<gMod.mscr.length;i++){
      var p = gMod.mscr[i];
      if(p.x < -40 || p.x > Wd+40 || p.y < -40 || p.y > Hd+40) continue;
      var hot = (i === gMod.hover);
      x.strokeStyle = hot ? '#E4C97E' : 'rgba(201,164,76,.55)';
      x.lineWidth = 1;
      x.beginPath(); x.arc(p.x, p.y, hot?13:10, 0, TAU); x.stroke();
      x.fillStyle = hot ? '#E4C97E' : 'rgba(239,229,206,.75)';
      x.fillText(gMod.names[gMod.majors[i].id] || 'TANPA NAMA', p.x, p.y-18);
    }
  } else if(gMod.hover >= 0 && gMod.mscr[gMod.hover]){
    var p2 = gMod.mscr[gMod.hover];
    x.strokeStyle = '#E4C97E'; x.lineWidth = 1;
    x.beginPath(); x.arc(p2.x, p2.y, 13, 0, TAU); x.stroke();
    x.fillStyle = '#E4C97E';
    x.fillText(gMod.names[gMod.majors[gMod.hover].id] || 'KLIK UNTUK MENAMAI', p2.x, p2.y-18);
  }
  if(zf > 6){
    x.fillStyle = 'rgba(228,201,126,.9)';
    x.font = '10px "JetBrains Mono",monospace';
    x.fillText('SAGITTARIUS A* · 4,3 JUTA M☉', cx, cy - gMod.scale*20);
  }
  if(t - gMod.lblT > 200){
    gMod.lblT = t;
    var z = $('#gZoomLbl'); if(z) z.textContent = 'ZOOM ×' + zf.toFixed(1).replace('.', ',');
  }
}

var gVis = false, oVis = false;
addTicker(function(dt,t){
  if(!gMod.ctx || !gVis) return;
  if(!gMod.drag) gMod.rot += .006*dt;
