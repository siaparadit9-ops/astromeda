var curRing = $('#cursor'), curDot = $('#cursorDot'), curLabel = $('#cursorLabel');
var curX = 0, curY = 0, mX = -100, mY = -100, curOn = false;
var lastTrail = {x:-999, y:-999};
function cursorFrame(){
  if(!curOn){ curRing.style.opacity = '0'; return; }
  curX += (mX-curX)*.22; curY += (mY-curY)*.22;
  curRing.style.opacity = '1';
  curRing.style.transform = 'translate3d('+curX+'px,'+curY+'px,0) translate(-50%,-50%)';
}
function resolveCursor(e){
  var t = e.target, mode = '', lbl = '';
  try{
    if(t.closest && t.closest('input,textarea,select')){ mode = 'hide'; }
    else{
      var dz = t.closest('[data-cursor]');
      if(dz) lbl = dz.getAttribute('data-cursor');
      if(t.closest('[data-edit]')) mode = 'text';
      else if(window.__gHot || window.__oHot) mode = 'hot';
      else if(t.closest('a,button,[data-img],label,.o-chip,.light-stop,.mini-moon,.cmdk-item,.planet,.spec-chip,.dso-card')) mode = 'hot';
      else if(t.closest('#galaxyCanvas') || t.closest('#orreryCanvas') || t.closest('#moonCanvas')) mode = 'gal';
    }
  }catch(err){}
  curRing.classList.toggle('hide', mode === 'hide');
  curRing.classList.toggle('hot', mode === 'hot');
  curRing.classList.toggle('text', mode === 'text');
  curRing.classList.toggle('gal', mode === 'gal');
  if(lbl) curLabel.textContent = lbl;
  else if(mode === 'text') curLabel.textContent = 'TULIS';
  else curLabel.textContent = '';
}
window.addEventListener('mousemove', function(e){
  rawX = e.clientX/window.innerWidth;
  rawY = e.clientY/window.innerHeight;
  mouseNX = rawX*2-1; mouseNY = rawY*2-1;
  mX = e.clientX; mY = e.clientY;
  if(!curOn){ curX = mX; curY = mY; curOn = true; }
  if(!REDUCED){
    curDot.style.transform = 'translate3d('+mX+'px,'+mY+'px,0) translate(-50%,-50%)';
    if(Math.hypot(mX-lastTrail.x, mY-lastTrail.y) > 17){
      trailPts.push({x:mX, y:mY, t:performance.now()});
      if(trailPts.length > 14) trailPts.shift();
      lastTrail = {x:mX, y:mY};
    }
  }
  resolveCursor(e);
}, {passive:true});
document.addEventListener('mouseleave', function(){ curOn = false; });
document.addEventListener('mousedown', function(){ curRing.classList.add('down'); });
document.addEventListener('mouseup', function(){ curRing.classList.remove('down'); });

function initMagnetics(){
  if(!FINE_POINTER || REDUCED) return;
  $$('.magnetic').forEach(function(b){
    if(b.__mag) return; b.__mag = 1;
    b.addEventListener('mousemove', function(e){
      var r = b.getBoundingClientRect();
      var dx = (e.clientX - r.left - r.width/2)*.22;
      var dy = (e.clientY - r.top - r.height/2)*.3;
