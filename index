  if(REDUCED) drawFrame(0,0);
  toast('Kepadatan bintang: ' + ({low:'jarang',normal:'normal',high:'rapat'})[k] + ' \u2014 ' + fmtInt(stars.length) + ' bintang');
}
var fpsVal = $('#fpsVal'), fpsBar = $('#fpsBar');
function updateFPS(){
  var fps = Math.min(240, Math.round(1000/fpsAvg));
  fpsVal.textContent = fps + ' FPS';
  fpsBar.style.width = Math.min(100, fps/120*100) + '%';
  fpsBar.className = fps >= 90 ? '' : (fps >= 50 ? 'mid' : 'low');
