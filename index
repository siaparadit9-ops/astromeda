      b.setAttribute('data-p', v);
      b.title = phaseName(v);
      var c = document.createElement('canvas'); c.width = 52; c.height = 52;
      drawPhase(c.getContext('2d'), 26, 26, 17, v);
      b.appendChild(c);
      wrap.appendChild(b);
    });
  }
  var drag = null;
  cvm.addEventListener('pointerdown', function(e){
    drag = {x:e.clientX};
    try{ cvm.setPointerCapture(e.pointerId); }catch(err){}
  });
  cvm.addEventListener('pointermove', function(e){
    if(!drag) return;
    mS.live = false;
    mS.p = (((mS.p + (e.clientX-drag.x)*.0011) % 1) + 1) % 1;
    drag.x = e.clientX;
    drawMoonUI();
  });
  cvm.addEventListener('pointerup', function(){ drag = null; });
  cvm.addEventListener('pointercancel', function(){ drag = null; });
  drawMoonUI();
}

