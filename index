  cvo.addEventListener('pointerdown', function(e){
    oS.drag = {x:e.clientX, y:e.clientY, moved:0, id:e.pointerId};
    try{ cvo.setPointerCapture(e.pointerId); }catch(err){}
  });
  cvo.addEventListener('pointermove', function(e){
    var r = cvo.getBoundingClientRect();
    var mx = e.clientX-r.left, my = e.clientY-r.top;
    if(oS.drag){
      var dx = e.clientX-oS.drag.x, dy = e.clientY-oS.drag.y;
      oS.drag.moved += Math.abs(dx)+Math.abs(dy);
      if(oS.drag.moved > 7){
        oS.panX += dx; oS.panY += dy;
        if(oS.focus){ oSetFocus(null); }
      }
      oS.drag.x = e.clientX; oS.drag.y = e.clientY;
      if(tip) tip.classList.remove('show');
      return;
    }
    var h = -1;
    for(var i=0;i<oS.scr.length;i++){
      if(Math.hypot(oS.scr[i].x-mx, oS.scr[i].y-my) < Math.max(12, oS.scr[i].r+8)){ h = i; break; }
    }
    oS.hover = h; window.__oHot = h >= 0;
    if(tip){
