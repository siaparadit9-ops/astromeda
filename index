function updateCoords(){
  var ra = rawX*24, rh = Math.floor(ra), rm = Math.floor((ra-rh)*60), rs = Math.floor((((ra-rh)*60)-rm)*60);
  var dec = 90 - rawY*180, ds = dec<0?'\u2212':'+', da = Math.abs(dec);
  var dd = Math.floor(da), dm = Math.floor((da-dd)*60);
  $('#coordsVal').textContent =
    'RA ' + rh + 'h ' + (rm<10?'0':'') + rm + 'm ' + (rs<10?'0':'') + rs + 's' +
    ' · DEC ' + ds + (dd<10?'0':'') + dd + '° ' + (dm<10?'0':'') + dm + '′';
}

