  if(gc) canvasObs.observe(gc);
  if(oc) canvasObs.observe(oc);
}
if(FINE_POINTER && !REDUCED) document.body.classList.add('cursor-fx');

setTimeout(function(){ var b = $('#boot'); if(b) b.remove(); }, REDUCED ? 60 : 1700);

startEngine();
refresh();
updateAlt();
syncSoundUI();
selectPlanet('altais', true);
selectSpec('G', true);
scrambleIn($('.hero-copy') || document);
tickClocks();

setTimeout(function(){
  $$('[data-reveal].in').forEach(function(r){ scrambleIn(r); });
}, 500);

if(loadedDraft) setTimeout(function(){ toast('Draft terakhir dimuat dari perangkat ini'); }, 1100);

})();
</script>
