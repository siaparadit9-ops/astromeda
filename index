function gZoomAt(mx,my,f){
  var s = gMod.scale, ns = clamp(s*f, gMod.min, gMod.max);
  if(ns === s) return;
  var dx = mx - gMod.W/2 - gMod.panX, dy = my - gMod.H/2 - gMod.panY;
  var c = Math.cos(-gMod.rot), sn = Math.sin(-gMod.rot);
  var wx = (dx*c - dy*sn)/s, wy = (dx*sn + dy*c)/s;
  var cr = Math.cos(gMod.rot), sr = Math.sin(gMod.rot);
  gMod.panX += (cr*wx - sr*wy)*(s-ns);
  gMod.panY += (sr*wx + cr*wy)*(s-ns);
  gMod.scale = ns;
}
function gScreenToGal(mx,my){
  var dx = mx - (gMod.W/2 + gMod.panX), dy = my - (gMod.H/2 + gMod.panY);
