function gResetView(){
  gMod.scale = gMod.fit*1.18; gMod.panX = 0; gMod.panY = 0; gMod.rot = 0; gMod.hyper = false;
}
function gNearestStarIdx(mx,my,rad){
  var best = -1, bd = rad*rad;
  for(var i=0;i<gMod.stars.length;i++){
    var st = gMod.stars[i];
    var rx = Math.cos(gMod.rot)*st.x - Math.sin(gMod.rot)*st.y;
    var ry = Math.sin(gMod.rot)*st.x + Math.cos(gMod.rot)*st.y;
    var sx = gMod.W/2 + gMod.panX + rx*gMod.scale;
    var sy = gMod.H/2 + gMod.panY + ry*gMod.scale;
    var d = (sx-mx)*(sx-mx)+(sy-my)*(sy-my);
    if(d < bd){ bd = d; best = i; }
  }
  return best;
}
function toggleConstMode(force){
  var on = force !== undefined ? force : !gMod.cmode;
  if(on && gMod.cpath.length) gFinishConst(false);
  gMod.cmode = on;
  document.body.classList.toggle('cmode', on);
  var b = $('#gConst');
  if(b) b.classList.toggle('on', on);
  var f = $('#galaxyFrame');
  if(f) f.setAttribute('data-cursor', on ? 'KLIK BINTANG · 2× KLIK SELESAI' : 'SERET · GULIR UNTUK ZOOM');
  var h = $('#gHint');
  if(h) h.textContent = on
    ? 'klik bintang untuk menghubungkan · klik ganda untuk mengakhiri rasi'
    : 'seret untuk memindah · gulir untuk zoom · klik bintang besar untuk menamai';
  if(on) toast('Mode rasi aktif — hubungkan bintang, klik ganda untuk selesai');
}
function gFinishConst(save){
  if(save && gMod.cpath.length >= 2){
    gMod.paths.push(gMod.cpath.slice());
    gPersist(); markDirty();
    toast('Rasi tersimpan — ' + gMod.cpath.length + ' bintang terhubung');
    snd(784,.09);
  }
  gMod.cpath = [];
}
function clearConstellations(){
  if(!gMod.paths.length && !gMod.cpath.length){ toast('Belum ada rasi untuk dihapus'); return; }
  var old = gMod.paths.slice();
  gMod.paths = []; gMod.cpath = [];
  gPersist(); markDirty();
  toast('Semua rasi dihapus', 'Urungkan', function(){
    gMod.paths = old; gPersist(); markDirty();
  });
}

function wireGalaxy(){
  var cvg = $('#galaxyCanvas'); if(!cvg) return;
  gMod.cv = cvg; gMod.ctx = cvg.getContext('2d');
  gMod.panX = 0; gMod.panY = 0; gMod.rot = 0;
  gMod.hover = -1; gMod.drag = null; gMod.hyper = false;
  gMod.cHover = -1; gMod.mouse = null;
  gResize();
  gMod.scale = gMod.fit*1.18;
  /* muat seed, nama, dan rasi dari DOM — ikut terekspor dalam berkas */
  var dataEl = $('#galaxyConstData');
  var seed = dataEl ? parseInt(dataEl.getAttribute('data-seed'),10) : NaN;
  if(!isNaN(seed) && seed !== gMod.seed){ gMod.seed = seed; }
  gGen(gMod.seed);
  gMod.names = {};
  $$('#galaxyNames li').forEach(function(li){
    var id = li.getAttribute('data-star');
    var t = li.textContent.trim();
    if(id && t && t.indexOf('TANPA NAMA') < 0) gMod.names[id] = t;
  });
  try{
    if(dataEl){
      var pp = JSON.parse(dataEl.getAttribute('data-paths') || '[]');
      if(Array.isArray(pp)) gMod.paths = pp.filter(function(p){ return Array.isArray(p); });
    }
  }catch(e){ gMod.paths = []; }
  gRegistry();
  toggleConstMode(gMod.cmode);
  cvg.addEventListener('pointerdown', function(e){
    gMod.drag = {x:e.clientX, y:e.clientY, moved:0, id:e.pointerId};
    try{ cvg.setPointerCapture(e.pointerId); }catch(err){}
  });
  cvg.addEventListener('pointermove', function(e){
    var r = cvg.getBoundingClientRect();
    var mx = e.clientX - r.left, my = e.clientY - r.top;
    gMod.mouse = {x:mx, y:my};
    if(gMod.drag){
      var dx = e.clientX - gMod.drag.x, dy = e.clientY - gMod.drag.y;
      gMod.drag.moved += Math.abs(dx) + Math.abs(dy);
      if(gMod.drag.moved > 7){
        gMod.panX += dx; gMod.panY += dy;
      }
      gMod.drag.x = e.clientX; gMod.drag.y = e.clientY;
    } else if(gMod.cmode){
      gMod.cHover = gNearestStarIdx(mx,my,16);
      window.__gHot = gMod.cHover >= 0;
    } else {
      var h = -1;
      for(var i=0;i<gMod.mscr.length;i++){
        if(Math.hypot(gMod.mscr[i].x-mx, gMod.mscr[i].y-my) < 20){ h = i; break; }
      }
      gMod.hover = h; window.__gHot = h >= 0;
    }
  });
  cvg.addEventListener('pointerup', function(e){
    if(!gMod.drag) return;
    var wasClick = gMod.drag.moved < 7;
    gMod.drag = null;
    if(!wasClick) return;
    var r = cvg.getBoundingClientRect();
    var mx = e.clientX - r.left, my = e.clientY - r.top;
    if(gMod.cmode){
      var idx = gNearestStarIdx(mx,my,18);
      if(idx >= 0){
        if(!gMod.cpath.length || gMod.cpath[gMod.cpath.length-1] !== idx){
          gMod.cpath.push(idx);
          snd(587,.05);
        }
      }
      return;
    }
    for(var i=0;i<gMod.mscr.length;i++){
      if(Math.hypot(gMod.mscr[i].x-mx, gMod.mscr[i].y-my) < 22){
        openStarModal(gMod.majors[i].id); return;
      }
    }
  });
  cvg.addEventListener('dblclick', function(){
    if(gMod.cmode && gMod.cpath.length >= 2) gFinishConst(true);
  });
  cvg.addEventListener('pointercancel', function(){ gMod.drag = null; });
  cvg.addEventListener('pointerleave', function(){
    gMod.hover = -1; gMod.cHover = -1; window.__gHot = false; gMod.mouse = null;
  });
  cvg.addEventListener('wheel', function(e){
    e.preventDefault();
    var r = cvg.getBoundingClientRect();
    gZoomAt(e.clientX - r.left, e.clientY - r.top, Math.exp(-e.deltaY*.0015));
    if(REDUCED) gDraw(performance.now());
  }, {passive:false});
  if(REDUCED) gDraw(performance.now());
}

