function ensureCtx(){
  if(!actx){ try{ actx = new (window.AudioContext||window.webkitAudioContext)(); }catch(e){} }
  if(actx && actx.state === 'suspended') actx.resume();
}
function snd(f,d,delay,type,g){
  if(!soundOn || !actx) return;
  try{
    var t = actx.currentTime + (delay||0);
    var o = actx.createOscillator(), v = actx.createGain();
    o.type = type||'sine'; o.frequency.value = f;
    v.gain.setValueAtTime(0.0001, t);
    v.gain.linearRampToValueAtTime(g||.045, t+.012);
    v.gain.exponentialRampToValueAtTime(.0001, t+(d||.12));
    o.connect(v); v.connect(actx.destination);
    o.start(t); o.stop(t+(d||.12)+.05);
  }catch(e){}
}
