/* ---- keadaan orrery ---- */
var oS = {cv:null, ctx:null, W:0, H:0, DPR:1, zoom:1, panX:0, panY:0,
  speed:8, playing:!REDUCED, days:0, labels:true, trails:true, belts:true,
  sel:2, hover:-1, kg:70, scr:[], dayT:0, focus:null, focusZoom:2.2,
  belt:[], kuiper:[], comet:null, tSpan:0};
var oR0 = 30, oRk = 40;
O_P.forEach(function(P,i){
  P.a0 = i*2.39996 + .7;
  P.texCv = TEXGEN[P.tex]();
  P.rot = (i*137.5) % 192;
});
function oResize(){
  var cvv = oS.cv; if(!cvv) return;
  var r = cvv.parentElement.getBoundingClientRect();
  oS.DPR = Math.min(window.devicePixelRatio||1, 2);
  oS.W = Math.round(r.width); oS.H = Math.round(r.height);
  cvv.width = oS.W*oS.DPR; cvv.height = oS.H*oS.DPR;
  cvv.style.width = oS.W+'px'; cvv.style.height = oS.H+'px';
  var maxR = Math.min(oS.W, oS.H)/2 - 24;
  oR0 = 30;
  oRk = (maxR - oR0)/Math.pow(30.07, .58);
}
function oAuR(au){ return oR0 + Math.pow(au,.58)*oRk; }
function oBuildBelts(){
  var rng = mulberry32(9090), i;
  oS.belt = [];
  for(i=0;i<260;i++){
    var au = 2.1 + rng()*1.25;
    oS.belt.push({au:au, per:365.25*Math.pow(au,1.5), a0:rng()*TAU,
      s:.5+rng()*.9, c:['#8B8474','#A79B87','#7A7163'][(rng()*3)|0], a:.35+rng()*.4});
  }
  oS.kuiper = [];
  for(i=0;i<320;i++){
    var au2 = 33 + rng()*14;
    oS.kuiper.push({au:au2, per:365.25*Math.pow(au2,1.5), a0:rng()*TAU,
      s:.5+rng()*.8, c:'#5B7FB5', a:.18+rng()*.25});
  }
  /* komet Hala: orbit lonjong, hampir di perihelion saat mulai */
  oS.comet = {a:24, e:.72, om:2.1, th:-.42,
    per:365.25*Math.pow(24,1.5), a0:0, px:2.6};
}
function cometPos(){
  var c = oS.comet;
  var r = c.a*(1-c.e*c.e)/(1+c.e*Math.cos(c.th));
  var px = Math.cos(c.th)*r, py = Math.sin(c.th)*r;
  var xr = Math.cos(c.om)*px - Math.sin(c.om)*py;
  var yr = Math.sin(c.om)*px + Math.cos(c.om)*py;
  return {au:r, x:xr, y:yr};
}
function drawRing(x,px,py,r,back){
  x.save(); x.translate(px,py); x.rotate(-.42);
  x.beginPath();
  if(back) x.rect(-r*3.2, -r*1.3, r*6.4, r*1.3);
  else     x.rect(-r*3.2, 0, r*6.4, r*1.3);
  x.clip();
  var bands = [
    [1.45,1.72,'rgba(228,201,126,.5)'],
    [1.78,2.06,'rgba(201,164,76,.72)'],
    [2.13,2.3,'rgba(228,201,126,.38)']
  ];
  for(var i=0;i<bands.length;i++){
    var b = bands[i];
    x.strokeStyle = b[2];
    x.lineWidth = (b[1]-b[0])*r;
    x.beginPath();
    x.ellipse(0,0,(b[0]+b[1])/2*r,((b[0]+b[1])/2*r)*.34,0,0,TAU);
    x.stroke();
  }
  x.restore();
}
function drawPlanet(x, P, px, py, r, sunDX, sunDY, zoom){
  if(P.atmo && r > 2){
    x.globalAlpha = Math.min(1,(zoom-.7))* .9;
    x.drawImage(atmoSprite(P.atmo), px-r*1.6, py-r*1.6, r*3.2, r*3.2);
    x.globalAlpha = 1;
  }
  if(P.ring && r > 3) drawRing(x, px, py, r, true);
  x.save();
  x.beginPath(); x.arc(px,py,r,0,TAU); x.clip();
  var W2 = r*4, off = ((P.rot % W2) + W2) % W2;
  x.drawImage(P.texCv, px-r-off, py-r, W2, r*2);
  x.drawImage(P.texCv, px-r-off+W2, py-r, W2, r*2);
  var g = x.createRadialGradient(px+sunDX*r*.75, py+sunDY*r*.75, r*.1, px, py, r*1.4);
  g.addColorStop(0,'rgba(5,10,24,0)');
  g.addColorStop(.52,'rgba(5,10,24,0)');
  g.addColorStop(1,'rgba(5,10,24,.94)');
  x.fillStyle = g;
  x.fillRect(px-r,py-r,r*2,r*2);
  x.restore();
  if(P.ring && r > 3) drawRing(x, px, py, r, false);
}
function oDraw(t){
  var x = oS.ctx; if(!x) return;
  x.setTransform(oS.DPR,0,0,oS.DPR,0,0);
  x.clearRect(0,0,oS.W,oS.H);
  var cx = oS.W/2 + oS.panX, cy = oS.H/2 + oS.panY, z = oS.zoom, i;
  /* lingkaran orbit */
  for(i=0;i<O_P.length;i++){
    var rr = oAuR(O_P[i].au)*z;
    x.strokeStyle = (i===oS.sel) ? 'rgba(201,164,76,.5)'
      : (i===oS.hover ? 'rgba(228,201,126,.3)' : 'rgba(239,229,206,.1)');
    x.lineWidth = 1;
    x.beginPath(); x.arc(cx,cy,rr,0,TAU); x.stroke();
  }
  /* sabuk asteroid & kuiper */
  if(oS.belts){
    function drawBelt(arr, dim){
      for(var k=0;k<arr.length;k++){
        var a = arr[k];
        var ang = a.a0 + oS.days/a.per*TAU;
        var R = oAuR(a.au)*z;
        x.globalAlpha = a.a*dim;
        x.fillStyle = a.c;
        x.fillRect(cx+Math.cos(ang)*R, cy+Math.sin(ang)*R, a.s, a.s);
      }
      x.globalAlpha = 1;
    }
    drawBelt(oS.belt, 1);
    drawBelt(oS.kuiper, .8);
    if(oS.labels && z > .8){
      x.font = '8.5px "JetBrains Mono",monospace'; x.textAlign = 'center';
      x.fillStyle = 'rgba(139,132,116,.75)';
      var bR = oAuR(2.7)*z;
      x.fillText('SABUK ASTEROID', cx+Math.cos(-.9)*bR, cy+Math.sin(-.9)*bR);
      if(z < 1.4){
        var kR = oAuR(40)*z;
        x.fillStyle = 'rgba(91,127,181,.55)';
        x.fillText('SABUK KUIPER', cx+Math.cos(-.9)*kR, cy+Math.sin(-.9)*kR);
      }
    }
  }
  /* matahari: korona + inti + prominensi */
  var sunR = 13*z;
  x.drawImage(coronaSprite(), cx-sunR*4.6, cy-sunR*4.6, sunR*9.2, sunR*9.2);
  var sg = x.createRadialGradient(cx,cy,0,cx,cy,sunR);
  sg.addColorStop(0,'#FFF8E4'); sg.addColorStop(.55,'#F2D98E'); sg.addColorStop(1,'#C9A44C');
  x.fillStyle = sg;
  x.beginPath(); x.arc(cx,cy,sunR,0,TAU); x.fill();
  if(t !== undefined){
    for(i=0;i<5;i++){
      var pa = i*(TAU/5) + t*.0002;
      var fl = .5+.5*Math.sin(t*.003+i*2.1);
      x.strokeStyle = 'rgba(255,220,150,'+(.25*fl)+')';
      x.lineWidth = 1.6;
      x.beginPath();
      x.moveTo(cx+Math.cos(pa)*sunR*.92, cy+Math.sin(pa)*sunR*.92);
      x.quadraticCurveTo(
        cx+Math.cos(pa+.25)*sunR*1.55, cy+Math.sin(pa+.25)*sunR*1.55,
        cx+Math.cos(pa+.5)*sunR*1.05, cy+Math.sin(pa+.5)*sunR*1.05);
      x.stroke();
    }
  }
  /* planet: jejak, bola, bulan */
  oS.scr = [];
  var moonAlpha = clamp((z-.85)/.5, 0, 1);
  for(i=0;i<O_P.length;i++){
    var P = O_P[i];
    var R = oAuR(P.au)*z;
    var a = P.a0 + oS.days/P.per*TAU;
    var px = cx + Math.cos(a)*R, py = cy + Math.sin(a)*R;
    var pr = Math.max(1.6, P.px*z);
    /* jejak orbit memudar */
    if(oS.trails && z > .5){
      var span = (oS.trails ? (14 + 36*(oS.speed/30)) : 0) * Math.PI/180;
      var segs = 16;
      for(var sgi=0;sgi<segs;sgi++){
        var a1 = a - span*(sgi/segs), a2 = a - span*((sgi+1)/segs);
        x.strokeStyle = 'rgba(228,201,126,'+(.4*(1-sgi/segs))+')';
        x.lineWidth = 1.4;
        x.beginPath();
        x.moveTo(cx+Math.cos(a1)*R, cy+Math.sin(a1)*R);
        x.lineTo(cx+Math.cos(a2)*R, cy+Math.sin(a2)*R);
        x.stroke();
      }
    }
    var sunLen = Math.hypot(px-cx, py-cy) || 1;
    drawPlanet(x, P, px, py, pr, (cx-px)/sunLen, (cy-py)/sunLen, z);
    /* bulan-bulan */
    if(P.moons.length && moonAlpha > 0 && pr > 3){
      for(var mi=0;mi<P.moons.length;mi++){
        var M = P.moons[mi];
        var ma = (mi*1.9) + oS.days/M.per*TAU;
        var md = M.d*pr;
        x.globalAlpha = moonAlpha;
        x.fillStyle = '#EFE5CE';
        x.beginPath();
        x.arc(px+Math.cos(ma)*md, py+Math.sin(ma)*md, Math.max(.8, M.s*pr), 0, TAU);
        x.fill();
        x.globalAlpha = 1;
      }
    }
    if(i===oS.sel || i===oS.hover){
      x.strokeStyle = '#E4C97E'; x.lineWidth = 1.2;
      x.beginPath(); x.arc(px,py,pr+6,0,TAU); x.stroke();
    }
    if(oS.labels){
      x.font = '9px "JetBrains Mono",monospace'; x.textAlign = 'left';
      x.fillStyle = (i===oS.sel) ? '#E4C97E' : 'rgba(239,229,206,.55)';
      x.fillText(P.n.toUpperCase(), px+pr+7, py-pr-5);
    }
    oS.scr.push({x:px, y:py, r:pr});
  }
  /* komet dengan ekor ganda */
  var C = oS.comet, cp = cometPos();
  var cR = oAuR(cp.au)*z;
  var cpx = cx + cp.x/Math.max(cp.au,.001)*cR*0 + cp.x*0; /* posisi via sudut om */
  var ccx = cx + (Math.cos(C.om)*cp.x - Math.sin(C.om)*cp.y)/1 * (cR/Math.max(cp.au,.001));
  var ccy = cy + (Math.sin(C.om)*cp.x + Math.cos(C.om)*cp.y) * (cR/Math.max(cp.au,.001));
  var sunDx = ccx-cx, sunDy = ccy-cy;
  var sd = Math.hypot(sunDx,sunDy)||1;
  var ux = sunDx/sd, uy = sunDy/sd;
  var act = clamp(2.2/Math.max(cp.au,1.2), 0, 1);
  if(act > .04){
    var tl = 26 + 90*act*z;
    var gg = x.createLinearGradient(ccx,ccy, ccx+ux*tl, ccy+uy*tl);
    gg.addColorStop(0,'rgba(250,247,239,.85)');
    gg.addColorStop(.35,'rgba(228,201,126,.4)');
    gg.addColorStop(1,'rgba(228,201,126,0)');
    x.strokeStyle = gg; x.lineWidth = 2.6;
    x.beginPath(); x.moveTo(ccx,ccy);
    x.quadraticCurveTo(ccx+ux*tl*.5 - uy*tl*.14, ccy+uy*tl*.5 + ux*tl*.14, ccx+ux*tl, ccy+uy*tl);
    x.stroke();
    var ig = x.createLinearGradient(ccx,ccy, ccx+ux*tl*1.15, ccy+uy*tl*1.15);
    ig.addColorStop(0,'rgba(155,179,255,.6)');
    ig.addColorStop(1,'rgba(155,179,255,0)');
    x.strokeStyle = ig; x.lineWidth = 1.4;
    x.beginPath(); x.moveTo(ccx,ccy); x.lineTo(ccx+ux*tl*1.15, ccy+uy*tl*1.15); x.stroke();
  }
  x.drawImage(glowSprite('#FAF7EF'), ccx-8, ccy-8, 16, 16);
  x.fillStyle = '#FAF7EF';
  x.beginPath(); x.arc(ccx,ccy,1.8,0,TAU); x.fill();
  if(oS.labels){
    x.font = '9px "JetBrains Mono",monospace'; x.textAlign = 'left';
    x.fillStyle = 'rgba(250,247,239,.65)';
    x.fillText('KOMET HALA', ccx+8, ccy-8);
  }
  oS.cometScr = {x:ccx, y:ccy};
}

addTicker(function(dt,t){
  if(!oS.ctx || !oVis) return;
  if(oS.playing){
    oS.days += dt*oS.speed*2;
    for(var i=0;i<O_P.length;i++){
      O_P[i].rot += dt*24/O_P[i].day*34;
    }
    var C = oS.comet, cp = cometPos();
    var L = TAU*C.a*C.a*Math.sqrt(1-C.e*C.e)/C.per;
    C.th += L/(cp.au*cp.au) * oS.speed*2*dt;
    if(C.th > TAU) C.th -= TAU;
  }
  /* kamera mengunci target */
  if(oS.focus){
    var tx = 0, ty = 0;
    if(oS.focus.type === 'planet'){
      var P = O_P[oS.focus.i];
      var R = oAuR(P.au)*oS.zoom;
      var a = P.a0 + oS.days/P.per*TAU;
      tx = -Math.cos(a)*R; ty = -Math.sin(a)*R;
    } else if(oS.focus.type === 'sun'){ tx = 0; ty = 0; }
    else if(oS.focus.type === 'comet' && oS.cometScr){
      tx = -(oS.cometScr.x - oS.W/2 - oS.panX);
      ty = -(oS.cometScr.y - oS.H/2 - oS.panY);
    }
    oS.panX += (tx-oS.panX)*.07;
    oS.panY += (ty-oS.panY)*.07;
    oS.zoom += (oS.focusZoom-oS.zoom)*.045;
    var zv = $('#oZoom'), zl = $('#oZoomVal');
    if(zv){ zv.value = oS.zoom; }
    if(zl){ zl.textContent = '×'+fmt(oS.zoom,1); }
  }
  oDraw(t);
  oS.dayT += dt;
  if(oS.dayT > .25){
    oS.dayT = 0;
    var d = $('#oDays');
    if(d) d.firstChild.textContent = 'HARI KE-' + fmtInt(Math.floor(oS.days));
    var dd = $('#oDate');
    if(dd){
      try{
        var sim = new Date(Date.now() + Math.floor(oS.days)*86400000);
        var MO = ['JAN','FEB','MAR','APR','MEI','JUN','JUL','AGU','SEP','OKT','NOV','DES'];
        dd.textContent = 'SIM ' + sim.getDate() + ' ' + MO[sim.getMonth()] + ' ' + sim.getFullYear();
      }catch(e){}
    }
  }
});

