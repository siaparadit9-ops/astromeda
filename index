function fmtDist(au){
  if(au < .01) return '0 km — titik keberangkatan';
  var km = au*149597870.7;
  if(km < 1e6)  return fmtInt(km) + ' ribu km';
  if(km < 1e9)  return fmt(km/1e6,1) + ' juta km';
  if(km < 1e12) return fmt(km/1e9,1) + ' miliar km';
  return fmt(km/1e12,1) + ' triliun km';
}
function fmtDur(s){
  if(s < 90)      return Math.round(s) + ' detik';
  if(s < 5400){   var m1 = Math.floor(s/60), r1 = Math.round(s%60); return m1+' menit'+(r1?' '+r1+' detik':''); }
  if(s < 172800){ var h1 = Math.floor(s/3600), m2 = Math.round((s%3600)/60); return h1+' jam'+(m2?' '+m2+' menit':''); }
  if(s < 31557600){ var d1 = Math.floor(s/86400), h2 = Math.round((s%86400)/3600); return d1+' hari'+(h2?' '+h2+' jam':''); }
  return fmt(s/31557600,2) + ' tahun';
}
