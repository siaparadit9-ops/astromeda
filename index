<script>
(function(){
'use strict';

/* ================================================================
   0. PERKAKAS DASAR
   ================================================================ */
var $  = function(s,c){ return (c||document).querySelector(s); };
var $$ = function(s,c){ return Array.prototype.slice.call((c||document).querySelectorAll(s)); };
var TAU = Math.PI*2;
var REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var FINE_POINTER = window.matchMedia('(pointer: fine)').matches;
function fmt(n,d){ return (n).toFixed(d===undefined?1:d).replace('.',','); }
function fmtInt(n){ return Math.round(n).toLocaleString('id-ID'); }
function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
/* PRNG deterministik — galaksi yang sama di setiap perangkat */
function mulberry32(seed){
  var a = seed>>>0;
  return function(){
    a |= 0; a = (a + 0x6D2B79F5) | 0;
    var t = Math.imul(a ^ (a>>>15), 1 | a);
    t = (t + Math.imul(t ^ (t>>>7), 61 | t)) ^ t;
    return ((t ^ (t>>>14)) >>> 0) / 4294967296;
  };
}

var page    = $('#page');
var userCss = $('#userCss');
var KEY     = 'vela.draft.v3';
var SKEY    = 'vela.sound.v1';
var editing = false, dirty = false, saveT = null, imgTarget = null;

/* snapshot versi awal berkas — untuk fitur reset */
var DEFAULT_HTML = page.innerHTML;
var DEFAULT_CSS  = userCss.textContent;

/* ================================================================
   1. DRAFT LOKAL
   ================================================================ */
var loadedDraft = false;
try{
  var raw = localStorage.getItem(KEY);
  if(raw){
    var d = JSON.parse(raw);
    if(typeof d.html === 'string' && d.html.trim()){ page.innerHTML = d.html; loadedDraft = true; }
    if(typeof d.css  === 'string') userCss.textContent = d.css;
  }
}catch(e){ /* penyimpanan tak tersedia — halaman tetap berjalan */ }

function cleanHTML(){
  var c = page.cloneNode(true);
  $$('.__tool', c).forEach(function(n){ n.remove(); });
  $$('.mq-clone', c).forEach(function(n){ n.remove(); });
  $$('a[data-href]', c).forEach(function(a){
    a.setAttribute('href', a.getAttribute('data-href'));
    a.removeAttribute('data-href'); a.removeAttribute('style');
  });
  $$('[data-split]', c).forEach(function(n){
    if(n.dataset.origTxt !== undefined) n.textContent = n.dataset.origTxt;
    n.removeAttribute('data-orig-txt'); n.removeAttribute('data-s-done');
  });
  $$('[data-words]', c).forEach(function(n){
    if(n.dataset.origHtml !== undefined) n.innerHTML = n.dataset.origHtml;
    n.removeAttribute('data-orig-html'); n.removeAttribute('data-w-done');
  });
  $$('[data-edit]', c).forEach(function(n){
    n.removeAttribute('contenteditable'); n.removeAttribute('spellcheck');
  });
  $$('[data-visited]', c).forEach(function(n){ n.removeAttribute('data-visited'); });
  return c.innerHTML;
}
function saveDraft(){
  try{ localStorage.setItem(KEY, JSON.stringify({html:cleanHTML(), css:userCss.textContent})); }catch(e){}
  dirty = false; setStatus('saved');
}
function markDirty(){
  dirty = true; setStatus('saving');
  clearTimeout(saveT); saveT = setTimeout(saveDraft, 700);
}
window.addEventListener('beforeunload', function(){ if(dirty) saveDraft(); });

var saveDot = $('#saveDot'), saveState = $('#saveState');
function setStatus(mode){
  if(mode === 'saving'){ saveState.textContent = 'Menyimpan\u2026'; saveDot.classList.add('saving'); }
  else{ saveState.textContent = 'Tersimpan'; saveDot.classList.remove('saving'); }
}

/* ================================================================
   2. PITA ORBIT
   ================================================================ */
function renderMarquee(){
  var track = $('#mqTrack'); if(!track) return;
  $$('.mq-clone', track).forEach(function(n){ n.remove(); });
  if(!editing){
    var u = $('.mq-unit', track);
    if(u){
      var cl = u.cloneNode(true);
      cl.classList.add('mq-clone');
      cl.setAttribute('aria-hidden','true');
      $$('[data-edit]', cl).forEach(function(n){
        n.removeAttribute('contenteditable'); n.removeAttribute('spellcheck');
      });
      track.appendChild(cl);
    }
  }
}

/* ================================================================
   3. ANIMASI TEKS — per karakter / per kata
   ================================================================ */
function splitText(el){
  if(el.dataset.sDone) return;
  var text = el.textContent;
  if(!text.trim()) return;
  el.dataset.origTxt = text;
  el.innerHTML = '';
  text.split('').forEach(function(ch,i){
    var s = document.createElement('span');
    s.className = 'ch';
    s.textContent = ch === ' ' ? '\u00A0' : ch;
    s.style.transitionDelay = (i*16) + 'ms';
    el.appendChild(s);
  });
  el.dataset.sDone = '1';
}
function wordify(el){
  if(el.dataset.wDone) return;
  if(!el.textContent.trim()) return;
  el.dataset.origHtml = el.innerHTML;
  var wi = 0;
  (function walk(node){
    Array.prototype.forEach.call(node.childNodes, function(ch){
      if(ch.nodeType === 3){
        var parts = ch.textContent.split(/(\s+)/);
        var frag = document.createDocumentFragment();
        parts.forEach(function(p){
          if(!p) return;
          if(/^\s+$/.test(p)){ frag.appendChild(document.createTextNode(p)); }
          else{
            var s = document.createElement('span');
            s.className = 'w'; s.textContent = p;
            s.style.transitionDelay = (wi*26) + 'ms'; wi++;
            frag.appendChild(s);
          }
        });
        node.replaceChild(frag, ch);
      } else if(ch.nodeType === 1 && !ch.classList.contains('w')){ walk(ch); }
    });
  })(el);
  el.dataset.wDone = '1';
}
function restoreText(el){
  if(el.dataset.sDone !== undefined && el.dataset.origTxt !== undefined){
    el.textContent = el.dataset.origTxt;
    delete el.dataset.sDone;
  }
  if(el.dataset.wDone !== undefined && el.dataset.origHtml !== undefined){
    el.innerHTML = el.dataset.origHtml;
    delete el.dataset.wDone;
  }
}
function stageText(entering){
  $$('[data-split],[data-words]').forEach(function(el){
    var visited = el.dataset.visited === '1';
    if(entering){ restoreText(el); }
    else if(visited){
      el.classList.add('in');
      if(el.hasAttribute('data-split')) splitText(el); else wordify(el);
    }
  });
}

/* ================================================================
   4. MODE SUNTING
   ================================================================ */
function setLinks(disarm){
  $$('a', page).forEach(function(a){
    if(disarm){
      if(!a.hasAttribute('data-href')) a.setAttribute('data-href', a.getAttribute('href')||'');
      a.removeAttribute('href'); a.style.cursor = 'text';
    }else if(a.hasAttribute('data-href')){
      a.setAttribute('href', a.getAttribute('data-href'));
      a.removeAttribute('data-href'); a.removeAttribute('style');
    }
  });
}
function mountTools(){
  $$('[data-section]', page).forEach(function(sec){
    if($('.__del', sec)) return;
    var b = document.createElement('button');
    b.type = 'button'; b.className = '__tool __del';
    b.innerHTML = '<svg class="ic" aria-hidden="true"><use href="#i-trash"/></svg>Hapus sektor';
    sec.appendChild(b);
  });
  var add = $('#addSection'); if(add) add.hidden = false;
}
function unmountTools(){
  $$('.__tool', page).forEach(function(n){ n.remove(); });
  var add = $('#addSection'); if(add) add.hidden = true;
}
function applyEditingDOM(){
  $$('[data-edit]', page).forEach(function(el){
    el.contentEditable = editing ? 'true' : 'false';
    el.spellcheck = false;
  });
  setLinks(editing);
  if(editing) mountTools(); else unmountTools();
  renderMarquee();
}
function setEditing(on){
  editing = on;
