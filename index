}

function gGen(seed){
  gMod.seed = seed;
  var rng = mulberry32(seed);
  gMod.stars = []; gMod.majors = []; gMod.hover = -1;
  var N = 2600, i;
  for(i=0;i<N;i++){
    var u = rng(), st = {ph: rng()*TAU, tw: .5+rng()*1.8, a: .3+rng()*.65};
    if(u < .58){ /* lengan spiral + spur */
      var r = 60 + Math.pow(rng(),.75)*560;
      var arm = i % 4;
      var p = armPoint(arm, r, rng, .16);
      if(rng() < .3){
        var p2 = armPoint((arm + (rng()<.5 ? 1 : 3)) % 4, r*(.8+rng()*.4), rng, .3);
        p = {x:(p.x+p2.x)/2, y:(p.y+p2.y)/2};
      }
      st.x = p.x + gGauss(rng)*9; st.y = p.y + gGauss(rng)*6;
      st.sp = pickSpec(rng, false);
    } else if(u < .72){ /* batang inti */
      var ba = rng()*TAU, br = Math.pow(rng(),.6)*130;
      st.x = Math.cos(ba)*br*1.9 + gGauss(rng)*8;
      st.y = Math.sin(ba)*br*.7 + gGauss(rng)*5;
      st.sp = pickSpec(rng, true);
    } else if(u < .90){ /* piringan */
      var da = rng()*TAU, dr = 60 + Math.pow(rng(),.5)*580;
      st.x = Math.cos(da)*dr; st.y = Math.sin(da)*dr*.62;
      st.sp = pickSpec(rng, rng() < .5);
    } else { /* halo */
      var ha = rng()*TAU, hr = 200 + rng()*480;
      st.x = Math.cos(ha)*hr*1.3; st.y = Math.sin(ha)*hr;
      st.sp = pickSpec(rng, true);
      st.a *= .5;
    }
    st.s = st.sp.s*(.5+rng()*.95);
    st.c = st.sp.c;
    gMod.stars.push(st);
  }
  for(i=0;i<8;i++){
    var rr = 150 + rng()*430;
    var aa = (i%4)*(Math.PI/2) + rr*.0056*2.6/2.6 + (rng()-.5)*.4;
    gMod.majors.push({id:'m'+(i+1), x:Math.cos(aa)*rr, y:Math.sin(aa)*rr*.62});
  }
  buildGalaxyLayers(rng);
  var sl = $('#gStarLbl'); if(sl) sl.textContent = fmtInt(N) + ' BINTANG';
  var sd = $('#gSeedLbl'); if(sd) sd.textContent = '#' + seed;
}

function buildGalaxyLayers(rng){
  var mk = function(w,h){ var c = document.createElement('canvas'); c.width = w; c.height = h; return c; };
  /* lapisan: galaksi latar → kabut → debu → H-II → halo gugus */
  var L = {bg:mk(1400,900), neb:mk(1400,900), dust:mk(1400,900), hii:mk(1400,900), halo:mk(1400,900)};
  var i;
  /* galaksi-galaksi jauh */
  var bx = L.bg.getContext('2d');
  for(i=0;i<14;i++){
    var gx = 120+rng()*1160, gy = 120+rng()*660;
    var gr = 6+rng()*16, tilt = rng()*Math.PI;
    var col = rng()<.4 ? 'rgba(228,201,126,' : (rng()<.5 ? 'rgba(155,179,255,' : 'rgba(239,229,206,');
    bx.save(); bx.translate(gx,gy); bx.rotate(tilt);
    var gg = bx.createRadialGradient(0,0,0,0,0,gr);
    gg.addColorStop(0, col+'.22)');
    gg.addColorStop(1, col+'0)');
    bx.fillStyle = gg;
    bx.scale(1,.42);
    bx.beginPath(); bx.arc(0,0,gr,0,TAU); bx.fill();
    bx.restore();
  }
  /* kabut terang mengikuti lengan */
  var nx = L.neb.getContext('2d');
  function blob(x2,c,r,px,py){
    var g = x2.createRadialGradient(px+700,py+450,0,px+700,py+450,r);
    g.addColorStop(0,c); g.addColorStop(1,'rgba(10,18,38,0)');
    x2.fillStyle = g; x2.fillRect(0,0,1400,900);
  }
  blob(nx,'rgba(228,201,126,.36)',240,0,0);
  blob(nx,'rgba(201,164,76,.18)',200,150,-90);
  for(i=0;i<22;i++){
    var ar = i%4, r = 100+rng()*500;
    var p = armPoint(ar, r, rng, .14);
    var which = rng();
    var c = which<.4 ? 'rgba(201,164,76,.13)' : (which<.7 ? 'rgba(76,135,103,.11)' : 'rgba(91,127,181,.11)');
    blob(nx, c, 70+rng()*110, p.x, p.y);
  }
  /* jalur debu gelap di tepi dalam lengan */
  var dx = L.dust.getContext('2d');
  for(i=0;i<30;i++){
    var ar2 = i%4, r2 = 90+rng()*520;
    var pp = armPoint(ar2, r2, rng, .1);
    var ang = Math.atan2(pp.y, pp.x*.6);
    var cxx = pp.x+700, cyy = pp.y+450;
    for(var j=0;j<3;j++){
      var rr2 = 26+rng()*54;
      var g2 = dx.createRadialGradient(cxx+Math.cos(ang)*j*rr2*.7, cyy+Math.sin(ang)*j*rr2*.7, 0,
        cxx+Math.cos(ang)*j*rr2*.7, cyy+Math.sin(ang)*j*rr2*.7, rr2);
      g2.addColorStop(0,'rgba(3,6,14,.4)');
      g2.addColorStop(1,'rgba(3,6,14,0)');
      dx.fillStyle = g2;
      dx.beginPath();
      dx.arc(cxx+Math.cos(ang)*j*rr2*.7, cyy+Math.sin(ang)*j*rr2*.7, rr2, 0, TAU);
      dx.fill();
    }
  }
  /* kantong pembentuk bintang (H-II) menembus debu */
  var hx = L.hii.getContext('2d');
  for(i=0;i<18;i++){
    var ar3 = i%4, r3 = 130+rng()*500;
    var p3 = armPoint(ar3, r3, rng, .12);
    var cx3 = p3.x+700, cy3 = p3.y+450, rr3 = 16+rng()*30;
    var g3 = hx.createRadialGradient(cx3,cy3,0,cx3,cy3,rr3);
    var warm = rng() < .75;
    g3.addColorStop(0, warm ? 'rgba(255,170,150,.5)' : 'rgba(150,220,190,.4)');
    g3.addColorStop(.4, warm ? 'rgba(255,140,120,.18)' : 'rgba(111,180,141,.14)');
    g3.addColorStop(1,'rgba(255,140,120,0)');
    hx.fillStyle = g3;
    hx.beginPath(); hx.arc(cx3,cy3,rr3,0,TAU); hx.fill();
    hx.fillStyle = 'rgba(255,235,225,.85)';
    hx.beginPath(); hx.arc(cx3,cy3,1.4+rng()*1.6,0,TAU); hx.fill();
  }
  /* gugus globular di halo */
  var gx2 = L.halo.getContext('2d');
