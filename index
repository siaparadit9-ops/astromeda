}
function wireOrrery(){
  var cvo = $('#orreryCanvas'); if(!cvo) return;
  oS.cv = cvo; oS.ctx = cvo.getContext('2d');
  oS.panX = 0; oS.panY = 0; oS.zoom = 1; oS.hover = -1; oS.drag = null;
  oResize();
